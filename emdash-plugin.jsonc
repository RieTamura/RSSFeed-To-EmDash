{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "rss-feed",
	"publisher": "did:plc:myrtyr2rsjiivzlp5m6qevv5",

	"license": "MIT",
	"author": { "name": "Rie Tamura", "url": "https://bsky.app/profile/connectobasan.com" },
	"security": { "url": "https://github.com/RieTamura/RSSFeed-To-EmDash/issues" },
	"name": "RSS Feed To EmDash",
	"description": "Shows YouTube videos and posts from note, Zenn and Hatena Blog on your EmDash site by syncing their RSS and Atom feeds into a collection.",
	"keywords": ["rss", "atom", "feed", "youtube", "blog"],
	"repo": "https://github.com/RieTamura/RSSFeed-To-EmDash",

	// Trust contract — what runtime APIs the plugin asks for.
	// Changing these between releases requires a version bump because
	// installed users have consented to the old contract.
	"capabilities": [
		// Read the feed.
		"network:request",
		// Check that the target collection has the fields the plugin writes.
		"schema:read",
		// Save each new item as an entry, then publish it.
		"content:write",
		"content:publish"
	],
	// The feed services this plugin knows. Hatena Blog on a custom domain is not covered.
	"allowedHosts": [
		"www.youtube.com",
		"note.com",
		"zenn.dev",
		"*.hatenablog.com",
		"*.hatenablog.jp",
		"*.hateblo.jp",
		"*.hatenadiary.com",
		"*.hatenadiary.jp"
	],
	"storage": {
		// One record per saved item, keyed by a hash of its feed id, so an item deleted in the admin is not saved again.
		"items": { "indexes": ["postedAt"] }
	},

	"admin": {
		"settingsSchema": {
			"feed_urls": {
				"label": "Feed URLs",
				"description": "One RSS or Atom feed per line. Every 30 minutes the plugin reads one of them, in turn. YouTube: https://www.youtube.com/feeds/videos.xml?channel_id=… note: https://note.com/<user>/rss Zenn: https://zenn.dev/<user>/feed Hatena Blog: https://<blog>.hatenablog.com/rss",
				"type": "string",
				"multiline": true
			},
			"limit": {
				"label": "Items to import",
				"description": "How many of the newest items in each feed to save. A YouTube feed holds 15, blog feeds 20 to 30.",
				"type": "number",
				"default": 15,
				"min": 1,
				"max": 30
			},
			"include_shorts": {
				"label": "Include YouTube Shorts",
				"description": "Also save Shorts from a YouTube channel feed.",
				"type": "boolean",
				"default": false
			},
			"collection": {
				"label": "Collection",
				"description": "The collection items are saved to. It must have the fields listed in the plugin README.",
				"type": "string",
				"default": "feed_items"
			}
		}
	}
}
